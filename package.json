{
  "name": "notation-labs",
  "private": true,
  "version": "1.7.0",
  "description": "A combo tracker for fighting game players.",
  "homepage": "https://github.com/kevinkickback/notation.LABS",
  "author": {
    "name": "KevinKickback",
    "url": "https://github.com/kevinkickback"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:web": "cross-env ELECTRON=false vite --open",
    "dev:app": "cross-env ELECTRON=true vite --no-open",
    "build:web": "tsc -b && cross-env ELECTRON=false vite build",
    "build:app": "tsc -b && cross-env ELECTRON=true vite build && electron-builder",
    "lint": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "assets:optimize": "svgo --folder src/assets/motion-icons --output src/assets/motion-icons --multipass",
    "dev:import-md": "node scripts/import-from-md.mjs",
    "version:check": "node .github/check-package-version.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "electron": "^41.10.5",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "playwright": "^1.62.1",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.notationlabs.app",
    "productName": "Notation Labs",
    "copyright": "Copyright © 2026 KevinKickback",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "icon": "build/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "kevinkickback",
      "repo": "notation.LABS",
      "releaseType": "draft"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "extraResources": [
      {
        "from": "build/splash.html",
        "to": "splash.html"
      },
      {
        "from": "build/splash.png",
        "to": "splash.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "portable": {
      "artifactName": "Notation-Labs-${version}-Win-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Notation-Labs-${version}-Win.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/uninstaller.nsh"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg"
    },
    "dmg": {
      "artifactName": "Notation-Labs-${version}-Mac.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "synopsis": "A combo tracker for fighting game players",
      "description": "Build, visualize, organize, and share fighting game combos."
    },
    "appImage": {
      "artifactName": "Notation-Labs-${version}-Linux.${ext}"
    },
    "deb": {
      "artifactName": "Notation-Labs-${version}-Linux.${ext}",
      "packageCategory": "games",
      "priority": "optional",
      "maintainer": "KevinKickback <kevinkickback@users.noreply.github.com>"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "allowScripts": {
    "@swc/core@1.15.18": true,
    "electron@41.10.5": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
